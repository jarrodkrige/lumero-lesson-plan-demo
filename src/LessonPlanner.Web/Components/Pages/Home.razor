@page "/"
@attribute [AllowAnonymous]

<PageTitle>Lesson planner | Agent demo</PageTitle>

<section class="welcome-introduction" aria-labelledby="welcome-heading">
    <h1 id="welcome-heading">Plan a computing lesson</h1>
    <AuthorizeView Policy="Presenter">
        <Authorized><a class="button" href="/presenter">New lesson</a></Authorized>
        <NotAuthorized><a class="button" href="/auth/sign-in">Sign in</a></NotAuthorized>
    </AuthorizeView>
</section>

<section class="pupil-guidance" aria-labelledby="pupil-heading">
    <h2 id="pupil-heading">Joining a quiz?</h2>
    <p>Open your teacher's link or scan their QR code.</p>
</section>
