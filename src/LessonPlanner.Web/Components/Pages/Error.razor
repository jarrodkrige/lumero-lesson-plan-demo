@page "/error"
@attribute [AllowAnonymous]
@inherits ResourcePage

<PageTitle>Page could not be completed | Agent demo</PageTitle>
<UnavailableState Title="The page could not be completed"
                  Message="Try opening the page again in a moment. If you were publishing a quiz or submitting answers, check the saved status before trying again." />

@code {
    protected override void OnInitialized() => SetStatusCode(StatusCodes.Status500InternalServerError);
}
