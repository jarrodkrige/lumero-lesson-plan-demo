@page "/not-found"
@attribute [AllowAnonymous]
@inherits ResourcePage

<PageTitle>Page not found | Agent demo</PageTitle>
<UnavailableState Title="Page not found"
                  Message="Check the link and try again. If you were joining a quiz, ask your teacher for the current classroom link." />

@code {
    protected override void OnInitialized() => SetStatusCode(StatusCodes.Status404NotFound);
}