@page "/access-denied"
@attribute [AllowAnonymous]
@inherits ResourcePage

<PageTitle>Presenter access unavailable | Agent demo</PageTitle>
<UnavailableState Title="This account does not have presenter access"
                  Message="Use an approved teaching account, or ask the organiser to check your access."
                  Link="/auth/sign-in" LinkText="Sign in" />

@code {
    protected override void OnInitialized() => SetStatusCode(StatusCodes.Status403Forbidden);
}
