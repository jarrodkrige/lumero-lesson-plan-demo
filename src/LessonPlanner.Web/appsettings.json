{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity.Web": "Warning",
      "Azure": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "ModelContextProtocol": "Warning",
      "Microsoft.Agents.AI": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id>",
    "ClientId": "<web-app-client-id>",
    "ClientCredentials": [
      {
        "SourceType": "SignedAssertionFromManagedIdentity",
        "ManagedIdentityClientId": "<web-workload-client-id>"
      }
    ]
  },
  "Presenter": { "AllowedObjectIds": ["<presenter-object-id>"] },
  "Mcp": {
    "Endpoint": "https://<internal-mcp-host>/mcp",
    "TokenScope": "api://<mcp-api-client-id>/.default",
    "CallerClientId": "<web-workload-client-id>",
    "ManagedIdentityClientId": "<web-workload-client-id>"
  },
  "Storage": {
    "TableServiceUri": "https://<storage-account>.table.core.windows.net",
    "TableName": "lessonplanner",
    "ManagedIdentityClientId": "<web-workload-client-id>"
  },
  "DataProtection": {
    "BlobUri": "https://<storage-account>.blob.core.windows.net/<private-container>/lumero-keys.xml",
    "ManagedIdentityClientId": "<web-workload-client-id>"
  },
  "ReverseProxy": { "KnownNetworks": [] },
  "Foundry": {
    "Endpoint": "https://<approved-foundry-resource>.services.ai.azure.com/openai/v1/",
    "Deployment": "<approved-existing-model-deployment>",
    "ManagedIdentityClientId": "<web-workload-client-id>"
  },
  "Quiz": {
    "PublicBaseUrl": "https://<public-web-host>",
    "LifetimeHours": 24,
    "ApprovalMinutes": 5,
    "MaximumAttempts": 200
  }
}
