{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Warning",
      "ModelContextProtocol": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mcp": {
    "TenantId": "<tenant-id>",
    "Audience": "<mcp-api-client-id>",
    "CallerClientId": "<web-workload-client-id>",
    "RequiredRole": "Quiz.Publish"
  },
  "Storage": {
    "TableServiceUri": "https://<storage-account>.table.core.windows.net",
    "TableName": "lessonplanner",
    "ManagedIdentityClientId": "<mcp-workload-client-id>"
  },
  "Quiz": {
    "PublicBaseUrl": "https://<public-web-host>",
    "LifetimeHours": 24,
    "ApprovalMinutes": 5,
    "MaximumAttempts": 200
  }
}
