// Compile-only contract example. EVERY environment value is deliberately invalid.
// Never deploy this file. Supply approved private values outside public artefacts.
using './main.bicep'

param applicationResourceGroupName = '<application-rg>'
param location = '<approved-region>'
param managedResourceGroupName = '<service-managed-rg>'
param containerAppsEnvironmentName = '<aca-environment>'
param virtualNetworkName = '<customer-vnet>'
param virtualNetworkAddressPrefix = '<approved-vnet-cidr>'
param acaSubnetName = '<exclusive-aca-subnet>'
param acaSubnetAddressPrefix = '<approved-exclusive-cidr>/23'
param privateEndpointSubnetName = '<private-endpoint-subnet>'
param privateEndpointSubnetAddressPrefix = '<approved-endpoint-cidr>/27'
param tablePrivateEndpointName = '<table-private-endpoint>'
param blobPrivateEndpointName = '<blob-private-endpoint>'
param privateDnsVnetLinkName = '<private-dns-vnet-link>'
param containerRegistryName = '<registry>'
param storageAccountName = '<storage-account>'
param logAnalyticsWorkspaceName = '<log-workspace>'
param environmentDiagnosticSettingName = '<environment-logs>'
param webIdentityName = '<web-uami>'
param mcpIdentityName = '<mcp-uami>'
param githubBuildIdentityName = '<build-uami>'
param githubReleaseIdentityName = '<release-uami>'
param githubBuildFederatedCredentialName = '<build-federation>'
param githubReleaseFederatedCredentialName = '<release-federation>'
param releaseRoleName = '<approved-custom-role>'
param releaseRoleDefinitionGuid = '<private-stable-role-guid>'
param existingFoundrySubscriptionId = '<existing-foundry-subscription-id>'
param existingFoundryResourceGroupName = '<existing-foundry-rg>'
param existingFoundryAccountName = '<existing-foundry-account>'
param tags = {
  owner: '<non-pii-owner-label>'
  workshop: '<approved-workshop-label>'
  'approved-expiry': '<approved-expiry-utc>'
  'source-revision': '<validated-source-commit>'
}
